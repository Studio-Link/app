<ul class="chat">
	{{#each this}}

	<li class="left clearfix">
		<div class="chat-body clearfix">
			<div class="header">
	{{#if self}}
				<strong class="primary-font">Me</strong>
	{{else}}
				<strong class="primary-font">{{peer}}</strong>
	{{/if}}
				<small class="float-end text-muted">
					<i class="far fa-clock fa-fw" aria-hidden="true"></i> <span class="timestamp">{{@key}}</span>
				</small>
			</div>
			<p>
			{{message}}
			</p>
		</div>
	</li>

	{{/each}}
</ul>
