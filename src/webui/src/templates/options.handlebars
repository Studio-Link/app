<fieldset class="mb-3">
	<legend class="visually-hidden">Options</legend>
{{#each this}}
	<div class="form-check form-switch mb-2">
		<input class="form-check-input option-change" type="checkbox" role="switch"
			id="option-{{@key}}" data-option="{{@key}}"
			data-value="{{#if this}}{{else}}true{{/if}}"{{#if this}} checked{{/if}}>
		<label class="form-check-label" for="option-{{@key}}">
			{{#ifeq @key "monitoring"}}Monitoring{{/ifeq}}
			{{#ifeq @key "monorecord"}}Mono Local Recording{{/ifeq}}
			{{#ifeq @key "monostream"}}Mono Remote Streaming{{/ifeq}}
			{{#ifeq @key "verbose"}}Verbose Logging (SIP Trace){{/ifeq}}
		</label>
	</div>
{{/each}}
</fieldset>
<p>
	<a href="/logs.txt" download="studio-link-logs.txt" class="btn btn-secondary" aria-describedby="logs-hint">
		<i class="fa fa-download" aria-hidden="true"></i> Download logs
	</a>
	<small id="logs-hint" class="text-muted ms-2">Local log files of the last 7 starts</small>
</p>
