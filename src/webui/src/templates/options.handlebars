<table class="table table-striped">
	<thead>
		<th>Name</th>
		<th>State</th>
	</thead>
	<tbody>
{{#each this}}
	<tr>
		{{#ifeq @key "monitoring"}}<td>Monitoring</td>{{/ifeq}}
		{{#ifeq @key "monorecord"}}<td>Mono Local Recording</td>{{/ifeq}}
		{{#ifeq @key "monostream"}}<td>Mono Remote Streaming</td>{{/ifeq}}
		<td>
			<p>
			{{#if this}}
			<button data-option="{{@key}}" data-value="" class="btn btn-success bt-lg option-change">
				Enabled
			</button>
			{{else}}
			<button data-option="{{@key}}" data-value="true" class="btn btn-danger bt-lg option-change">
				Disabled
			</button>
			{{/if}}
			</p>
		</td>
	</tr>
{{/each}}
	</tbody>
</table>
<p>
	<a href="/logs.txt" download="studio-link-logs.txt" class="btn btn-secondary">
		<i class="fa fa-download" aria-hidden="true"></i> Download logs
	</a>
	<small class="text-muted ms-2">Local log files of the last 7 starts</small>
</p>
