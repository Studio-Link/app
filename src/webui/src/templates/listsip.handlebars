<button id="buttonaddsip" type="button" class="btn btn-primary mb-2">
	<i class="fas fa-plus-circle" aria-hidden="true"></i> New Account
</button>
<div class="table-responsive" role="region" aria-label="SIP accounts" tabindex="0">
<table class="table table-striped">
	<caption class="visually-hidden">SIP accounts</caption>
	<thead>
		<tr>
			<th>Account</th>
			<th>Status</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		{{#each this}}
		<tr>
			<td>{{user}}@{{domain}}</td>
			{{#if status}}
				<td><span class="badge text-bg-success">Online</span></td>
			{{else}}
				<td><span class="badge text-bg-danger">Offline</span></td>
			{{/if}}
			<td>
				<p>
				<button type="button" data-user="{{user}}" data-domain="{{domain}}" class="btn btn-primary btn-sm editsip" aria-label="Edit {{user}}@{{domain}}" title="Edit"><i class="fas fa-edit" aria-hidden="true"></i></button>
				<button type="button" data-user="{{user}}" data-domain="{{domain}}" class="btn btn-danger btn-sm delete-button deletesip" aria-label="Delete {{user}}@{{domain}}" title="Delete">
					<i class="fas fa-trash-alt" aria-hidden="true"></i>
				</button>
				</p>
			</td>
		</tr>
		{{/each}}
	</tbody>
</table>
</div>
