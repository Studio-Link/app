{{#each this}}
<div class="card mb-2">
    <div class="card-header card-header-sm"><b>Remote Track {{track}}</b>
        <button aria-label="Channel Mix" data-key="{{@key}}" class="btn btn-primary btn-sm chmix"
            style="margin-top: -2px;">
            {{chmix}}
        </button>

        <div class="dropdown btn-group" style="margin-top: -2px;">
            <button title="Options" aria-label="Options" class="btn btn-primary btn-sm dropdown-toggle" type="button"
                id="dropdown{{@key}}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-bs-display="static">
                <span class="fa fa-cog" aria-hidden="true"></span> Options
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdown{{@key}}">
                <button aria-label="Add Contact" data-key="{{mysip peer}}"
                    class="dropdown-item addcontactshort {{contacthide}}" style="margin-top: -2px;">
                    <span class="fa fa-user-plus" aria-hidden="true"></span> Add Contact
                </button>
                <button aria-label="DTMF" data-key="{{@key}}" class="dropdown-item keyboard" style="margin-top: -2px;">
                    <span class="fas fa-th" aria-hidden="true"></span> DTMF Keyboard
                </button>
                <div class="dropdown-divider"></div>
                <form class="px-4">
                    <div class="mb-3">
                        <label class="dropdown-header" for="formControlRange{{@key}}">Volume ({{volume}})</label>
                        <input type="range" min="0" max="2" step="0.05" value="{{volume}}" class="form-range volume"
                            id="formControlRange{{@key}}" data-key="{{@key}}">
                    </div>
                </form>
            </div>
        </div>

        <div class="float-end">
            <span class="netstatus" id="netstatus{{track}}" tabindex="0" role="button"
                aria-label="Network status, show connection details">
                <i class="fas fa-signal netstatus-icon netstatus-none"></i>
                <div class="netstatus-info" role="tooltip">
                    <table>
                        <tbody>
                            <tr><th colspan="2">Network</th></tr>
                            <tr><td>Quality</td><td data-stat="quality">-</td></tr>
                            <tr><td>Round trip</td><td data-stat="rtt">-</td></tr>
                            <tr><td>Bitrate rx / tx</td><td data-stat="bitrate">-</td></tr>
                            <tr><td>Packets rx / tx</td><td data-stat="packets">-</td></tr>
                            <tr><td>Lost rx / tx</td><td data-stat="lost">-</td></tr>
                            <tr><td>Jitter rx / tx</td><td data-stat="jitter">-</td></tr>
                            <tr><th colspan="2">Jitter buffer</th></tr>
                            <tr><td>Delay</td><td data-stat="jb_delay">-</td></tr>
                            <tr><td>Jitter</td><td data-stat="jb_jitter">-</td></tr>
                            <tr><td>Skew</td><td data-stat="jb_skew">-</td></tr>
                            <tr><td>Packets</td><td data-stat="jb_packets">-</td></tr>
                            <tr><td>Lost</td><td data-stat="jb_lost">-</td></tr>
                            <tr><td>Late / late lost</td><td data-stat="jb_late">-</td></tr>
                            <tr><td>Out of seq. / dups</td><td data-stat="jb_oos">-</td></tr>
                            <tr><td>Overflow / flush</td><td data-stat="jb_overflow">-</td></tr>
                            <tr><th colspan="2">Audio buffer</th></tr>
                            <tr><td>Playout</td><td data-stat="buffer">-</td></tr>
                        </tbody>
                    </table>
                </div>
            </span>
            <span class="badge text-bg-primary">{{state}}</span>
            <button aria-label="Cancel Call" data-key="{{@key}}" class="btn btn-danger btn-sm hangup"
                style="margin-top: -2px;">
                <i class="fas fa-phone-slash"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        ID: {{mysip peer}}
        <div id="headphonesbar{{ch}}" class="progress progress-sm"></div>
    </div>
</div>
{{/each}}
