{{#each this}}
<section class="sl-track" style="order: {{track}}" aria-labelledby="track-title{{@key}}">
    <div class="sl-track-head">
        <h2 class="sl-track-heading" id="track-title{{@key}}">
            <span class="sl-track-no"><span class="visually-hidden">Track </span>{{inc track}}</span>
            <span class="sl-track-title text-truncate" title="{{mysip peer}}">{{mysip peer}}</span>
        </h2>
        <span class="netstatus ms-auto" id="netstatus{{track}}">
            <button type="button" class="btn btn-link btn-sm sl-icon-btn netstatus-btn"
                aria-describedby="netstatus-info{{track}}">
                <i class="fas fa-signal netstatus-icon netstatus-none" aria-hidden="true"></i>
                <span class="visually-hidden netstatus-label">Network quality: no data</span>
            </button>
            <div class="netstatus-info" id="netstatus-info{{track}}" role="tooltip">
                    <table>
                    <caption class="visually-hidden">Connection details</caption>
                        <tbody>
                            <tr><th colspan="2">Network</th></tr>
                            <tr><td>Quality</td><td data-stat="quality">-</td></tr>
                            <tr><td>Round trip</td><td data-stat="rtt">-</td></tr>
                            <tr><td>Bitrate rx / tx</td><td data-stat="bitrate">-</td></tr>
                            <tr><td>Packets rx / tx</td><td data-stat="packets">-</td></tr>
                            <tr><td>Lost rx / tx</td><td data-stat="lost">-</td></tr>
                            <tr><td>Jitter rx / tx</td><td data-stat="jitter">-</td></tr>
                            <tr><th colspan="2">Jitter buffer</th></tr>
                            <tr><td>Delay</td><td data-stat="jb_delay">-</td></tr>
                            <tr><td>Jitter</td><td data-stat="jb_jitter">-</td></tr>
                            <tr><td>Skew</td><td data-stat="jb_skew">-</td></tr>
                            <tr><td>Packets</td><td data-stat="jb_packets">-</td></tr>
                            <tr><td>Lost</td><td data-stat="jb_lost">-</td></tr>
                            <tr><td>Late / late lost</td><td data-stat="jb_late">-</td></tr>
                            <tr><td>Out of seq. / dups</td><td data-stat="jb_oos">-</td></tr>
                            <tr><td>Overflow / flush</td><td data-stat="jb_overflow">-</td></tr>
                            <tr><th colspan="2">Audio buffer</th></tr>
                            <tr><td>Playout</td><td data-stat="buffer">-</td></tr>
                        </tbody>
                    </table>
                </div>
        </span>
        <div class="dropdown">
            <button title="Options" aria-label="Options for {{mysip peer}}" class="btn btn-link btn-sm sl-icon-btn" type="button"
                id="dropdown{{@key}}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-bs-display="static">
                <i class="fa fa-cog" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdown{{@key}}">
                <button type="button" data-key="{{mysip peer}}"
                    class="dropdown-item addcontactshort {{contacthide}}">
                    <span class="fa fa-user-plus" aria-hidden="true"></span> Add Contact
                </button>
                <button type="button" data-key="{{@key}}" class="dropdown-item keyboard">
                    <span class="fas fa-th" aria-hidden="true"></span> DTMF Keyboard
                </button>
                <div class="dropdown-divider" role="separator"></div>
                <form class="px-4">
                    <div class="mb-3">
                        <label class="dropdown-header px-0" for="formControlRange{{@key}}">Volume ({{volume}})</label>
                        <input type="range" min="0" max="2" step="0.05" value="{{volume}}" class="form-range volume"
                            id="formControlRange{{@key}}" data-key="{{@key}}">
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="sl-track-state">{{state}}</div>
    <div id="headphonesbar{{ch}}" class="sl-meter" role="group"
        aria-label="Level of {{mysip peer}}"></div>
    <div class="d-flex gap-2 mt-3">
        <button type="button" aria-label="Channel mix: {{chmix}}" data-key="{{@key}}" class="btn btn-secondary btn-sm chmix">{{chmix}}</button>
        <button type="button" data-key="{{@key}}" class="btn btn-danger btn-sm hangup ms-auto">
            <i class="fas fa-phone-slash" aria-hidden="true"></i> Hang up<span class="visually-hidden"> {{mysip peer}}</span>
        </button>
    </div>
</section>
{{/each}}
