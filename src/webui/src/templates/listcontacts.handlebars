<button id="buttonaddcontact" type="button" class="btn btn-primary mb-2">
	<i class="fa fa-user-plus" aria-hidden="true"></i> New Contact
</button>
<div class="table-responsive" role="region" aria-label="Contacts" tabindex="0">
<table class="table table-striped">
	<caption class="visually-hidden">Contacts</caption>
	<thead>
		<tr>
			<th>Name</th>
			<th>SIP</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<td>echo</td>
			<td>echo@studio.link</td>
			<td>
				<p>
				<button type="button" data-sip="echo@studio.link" class="btn btn-success btn-sm callcontact">
					<i class="fas fa-phone" aria-hidden="true"></i> Call<span class="visually-hidden"> echo</span>
				</button>
				</p>
			</td>
		</tr>
		<tr>
			<td>music</td>
			<td>music@studio.link</td>
			<td>
				<p>
				<button type="button" data-sip="music@studio.link" class="btn btn-success btn-sm callcontact">
					<i class="fas fa-phone" aria-hidden="true"></i> Call<span class="visually-hidden"> music</span>
				</button>
				</p>
			</td>
		</tr>
		<tr>
			<td>music1</td>
			<td>music1@studio.link</td>
			<td>
				<p>
				<button type="button" data-sip="music1@studio.link" class="btn btn-success btn-sm callcontact">
					<i class="fas fa-phone" aria-hidden="true"></i> Call<span class="visually-hidden"> music1</span>
				</button>
				</p>
			</td>
		</tr>

		{{#each this}}
		<tr>
			<td>{{name}}</td>
			<td>{{sip}}</td>
			<td>
				<p>
				<button type="button" data-sip="{{sip}}" class="btn btn-success btn-sm callcontact">
					<i class="fas fa-phone" aria-hidden="true"></i> Call<span class="visually-hidden"> {{name}}</span>
				</button>
				<button type="button" data-sip="{{sip}}" class="btn btn-danger btn-sm delete-button deletecontact">
					<i class="fas fa-trash-alt" aria-hidden="true"></i> Delete<span class="visually-hidden"> {{name}}</span>
				</button>
				</p>
			</td>
		</tr>
		{{/each}}
	</tbody>
</table>
</div>
