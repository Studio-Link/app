+	/* The source can be a real-time audio thread (e.g. a DAW plugin).
+	 * tx->mtx is held by the transmit thread while sending, never wait
+	 * for it here: use the last values seen if the lock is busy. Only
+	 * block once, if no values were seen yet. */
+	bool locked = mtx_trylock(tx->mtx) == thrd_success;
+	if (!locked && !tx->rt.valid) {
+		mtx_lock(tx->mtx);
+		locked = true;
+	}
+
+	if (locked) {
+		tx->rt.src_fmt = tx->src_fmt;
+		tx->rt.psize   = tx->psize;
+		tx->rt.valid   = true;
+		mtx_unlock(tx->mtx);
+	}
